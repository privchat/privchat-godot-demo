; Engine configuration file.
; privchat-godot-demo — PrivChat 通信验证演示工程
; 依赖：../privchat-godot/addons/privchat（通过 addons 目录软链接引入）

config_version=5

[application]

config/name="PrivchatGodotDemo"
run/main_scene="res://scenes/login.tscn"
config/features=PackedStringArray("4.5")

[autoload]

PrivchatSession="*res://scripts/privchat_session.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=640
; HiDPI:允许按显示器缩放开窗,否则 Retina 上按物理像素 1:1 渲染,
; 16px 字体只有 8 逻辑点大小,看起来小一半。
; 内容缩放:以上面的视口尺寸为设计基准等比放大,
; 窗口拉伸或换高分屏时 UI 跟着变大,而不是固定物理像素。
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/privchat/plugin.cfg")

[gui]

theme/custom="res://themes/demo_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
